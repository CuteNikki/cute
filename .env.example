# Postgres connection string
DATABASE_URL="postgresql://user:password@host:5432/cute"

# Random string, e.g. from `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Where the site runs. Passkeys only work on this address.
BETTER_AUTH_URL="http://localhost:3000"

# From https://discord.com/developers/applications > OAuth2
# Redirect URL: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# The only Discord account that can sign in to /admin: your user id
ADMIN_DISCORD_ID=""

# The photo storage's key, see the README's Photos section
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
