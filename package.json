{
  "name": "cute",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css}\"",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/passkey": "^1.7.27",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.75.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "packageManager": "bun@1.4.4",
  "prettier": {
    "endOfLine": "lf",
    "semi": true,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 80,
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports",
      "prettier-plugin-tailwindcss"
    ],
    "importOrder": [
      "<BUILTIN_MODULES>",
      "<THIRD_PARTY_MODULES>",
      "",
      "^lucide-react$",
      "",
      "^@/actions/(.*)$",
      "^@/data/(.*)$",
      "",
      "^@/(?!(actions|data|lib|app|components|hooks)/)(.*)$",
      "",
      "^@/lib/(.*)$",
      "^@/app/(.*)$",
      "",
      "^@/components/(.*)$",
      "^@/hooks/(.*)$",
      "",
      "^[.]"
    ],
    "tailwindStylesheet": "src/app/globals.css",
    "tailwindFunctions": [
      "cn",
      "cva"
    ]
  }
}
